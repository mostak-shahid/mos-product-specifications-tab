{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/admin.php?page=mos-product-specifications-tab",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "phpExtensionBundles": [
    "kitchen-sink"
  ],
  "meta": {
    "title": "Product Specifications Tab for WooCommerce",
    "description": "Create structured WooCommerce product specification tables",
    "author": "MosPress",
    "categories": [
      "ecommerce",
      "woocommerce"
    ]
  },
  "steps": [
    {
      "step": "login"
    },
    {
      "step": "installTheme",
      "themeZipFile": {
        "resource": "wordpress.org/themes",
        "slug": "astra"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginZipFile": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installPlugin",
      "pluginZipFile": {
        "resource": "wordpress.org/plugins",
        "slug": "mos-product-specifications-tab"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "blogname": "Product Specifications Tab Demo"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php wp_insert_post(['post_title' => 'Demo Product', 'post_type' => 'product', 'post_status' => 'publish', 'meta_input' => ['_price' => 99, '_regular_price' => 99, '_stock_status' => 'instock']]); ?>"
    }
  ]
}
